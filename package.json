{
  "name": "@testingbot/mcp-server",
  "version": "1.4.4",
  "main": "dist/index.js",
  "type": "module",
  "mcpName": "com.testingbot/mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testingbot/mcp-server.git"
  },
  "scripts": {
    "build": "npm run version:sync && npm run lint && npm run format:check && npm test && tsc",
    "start": "node dist/index.js",
    "dev": "NODE_ENV=development tsx watch --clear-screen=false src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "version": "npm run version:sync && git add manifest.json server.json plugins/testingbot/.claude-plugin/plugin.json plugins/testingbot/.mcp.json plugins/testingbot/.cursor-plugin/plugin.json plugins/testingbot/plugin.json plugins/testingbot/mcp.json gemini-extension.json",
    "dev:rebuild": "bash scripts/dev.sh",
    "mcpb": "bash scripts/build-mcpb.sh",
    "mcpb:validate": "mcpb validate manifest.json",
    "mcpb:smoke": "bash scripts/smoke-mcpb.sh"
  },
  "bin": {
    "testingbot-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "testingbot",
    "model-context-protocol",
    "testing",
    "selenium",
    "browser-testing",
    "mobile-testing",
    "cross-browser",
    "ai-tools"
  ],
  "author": "TestingBot",
  "license": "MIT",
  "description": "TestingBot's official MCP Server for AI-powered testing automation",
  "homepage": "https://github.com/testingbot/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/testingbot/mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@testingbot/automation-mcp": "^0.2.2",
    "dotenv": "^16.4.5",
    "fflate": "^0.8.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "testingbot-api": "^1.1.0",
    "testingbot-tunnel-launcher": "^1.2.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mocha": {
      ".": "^11.8.0",
      "diff": "^8.0.3",
      "serialize-javascript": "^7.1.0"
    },
    "applesign": {
      "uuid": "^11.1.1"
    },
    "qs": "^6.16.0",
    "morgan": "^1.12.1",
    "@puppeteer/browsers": "^3.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "^9.25.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.4.6",
    "vitest": "^4.1.11"
  }
}
